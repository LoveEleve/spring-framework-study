                <mxCell id="1jjiBpRoDKVTdoKWtJoe-59" value="ConversionService 是 Spring 3.0 引入的统一类型转换 API，用于替代传统的 PropertyEditor&#xa;  ===&#xa;  但是spring默认没有注册 ConversionService，所以这段代码默认是不执行的，也即依旧使用的是 PropertyEditor(这个也暂时不关心了)&#xa;  但是在springboot是会自动注册 ApplicationConversionService 的" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;textShadow=0;" vertex="1" parent="1">
                    <mxGeometry x="810" y="320" width="800" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-61" target="1jjiBpRoDKVTdoKWtJoe-65">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-61" value="&lt;font&gt;注册默认的嵌入值解析器（处理 @Value 占位符）&lt;/font&gt;&lt;div&gt;&lt;font&gt;提前初始化 LoadTimeWeaverAware Bean（AOP 织入）&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
