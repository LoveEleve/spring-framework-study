                <mxCell id="200" value="@Component&#xa;public class MyService implements BeanClassLoaderAware {&#xa;    private ClassLoader classLoader;&#xa;    &#xa;    @Override&#xa;    public void setBeanClassLoader(ClassLoader classLoader) {&#xa;        this.classLoader = classLoader;  // Spring自动调用&#xa;        // 可用于动态加载类、资源等&#xa;    }&#xa;}" style="text;whiteSpace=wrap;fontFamily=Menlo, Monaco, Courier New, monospace;strokeColor=default;dashed=1;dashPattern=12 12;" parent="1" vertex="1">
                    <mxGeometry x="3080" y="1209" width="520" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="201" value="@Component&#xa;public class UserService implements BeanNameAware {&#xa;    private String beanName;&#xa;    &#xa;    @Override&#xa;    public void setBeanName(String name) {&#xa;        this.beanName = name;  // Spring自动调用，通常是 &quot;userService&quot;&#xa;        System.out.println(&quot;My bean name is: &quot; + name);&#xa;    }&#xa;}&#xa;" style="text;whiteSpace=wrap;fontFamily=Menlo, Monaco, Courier New, monospace;strokeColor=default;dashed=1;dashPattern=12 12;" parent="1" vertex="1">
