                <mxCell id="MO5rZfF7vPib44zuhW4v-118" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;interface org.springframework.beans.factory.BeanFactoryAware&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&amp;nbsp;作用：让Bean获取BeanFactory的引用&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=none;fontColor=default;" parent="1" vertex="1">
                    <mxGeometry x="2870" y="1920" width="520" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="MO5rZfF7vPib44zuhW4v-119" value="@Component&#xa;public class DynamicBeanCreator implements BeanFactoryAware {&#xa;    private BeanFactory beanFactory;&#xa;    &#xa;    @Override&#xa;    public void setBeanFactory(BeanFactory beanFactory) {&#xa;        this.beanFactory = beanFactory;  // Spring自动调用&#xa;        // 可用于动态获取其他Bean&#xa;    }&#xa;    &#xa;    public void doSomething() {&#xa;        UserService service = beanFactory.getBean(UserService.class);&#xa;    }&#xa;}&#xa;" style="text;whiteSpace=wrap;fontFamily=Menlo, Monaco, Courier New, monospace;strokeColor=default;dashed=1;dashPattern=12 12;" parent="1" vertex="1">
                    <mxGeometry x="3510" y="1980" width="520" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="MO5rZfF7vPib44zuhW4v-120" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;这个属性的作用：在依赖检查和自动装配时，忽略这些接口类型的setter方法&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;为什么要这么做呢？&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;- 如果不忽略的话,Spring会尝试通过自动装备注入,但是这会导致循环依赖等问题&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp;- 这些setxxx()方法不要自动装配,而是通过特殊的回调机制&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;labelBackgroundColor=none;fontColor=#FF3333;" parent="1" vertex="1">
                    <mxGeometry x="2860" y="1720" width="510" height="100" as="geometry"/>
