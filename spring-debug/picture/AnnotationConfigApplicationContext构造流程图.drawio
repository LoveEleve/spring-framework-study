                <mxCell id="1jjiBpRoDKVTdoKWtJoe-72" value="DefaultListableBeanFactory.preInstantiateSingletons()" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1320" y="875" width="420" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-73" value="方法简介: 这个方法的核心就是两个for循环&#xa;    1. 第一个for循环：依次处理容器中的每一个beanName，进行实例化&#xa;    2. 第二个for循环：依次处理容器中的每一个beanName, 对是 SmartInitializingSingleton 类型的bean再进行额外的处理&#xa;" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=#FF3333;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
                    <mxGeometry x="760" y="940" width="770" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-75" target="1jjiBpRoDKVTdoKWtJoe-77">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-75" value="第一个for循环：for (String beanName : beanNames)" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
                    <mxGeometry x="1075" y="1040" width="350" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-77" target="1jjiBpRoDKVTdoKWtJoe-80">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-77" value="&lt;font&gt;在这里能进行实例化的条件: 非抽象 / 单例 / 非懒加载&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
