                    <mxGeometry x="1060" y="2370" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-135" value="&lt;font&gt;关键点是将当前beanName添加到&amp;nbsp;singletonsCurrentlyInCreation 集合中，&lt;/font&gt;&lt;div&gt;&lt;font&gt;在低版本的spring中,比如5.1.x,在这里只会看到该集合，但是在5.3.x版本中还多了一个集合：&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;inCreationCheckExclusions&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;这个集合的作用是为了spring的灵活性,用于排除特殊Bean的循环依赖检查&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- 当某个beanName位于这个集合中时，将不会进行循环依赖的检查,但是暂时没看到在哪里使用到了这个特性&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=12 12;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1520" y="2350" width="730" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-136" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-137" target="1jjiBpRoDKVTdoKWtJoe-140">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-137" value="&lt;font&gt;singletonObject = singletonFactory.getObject()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="2510" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-138" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-140" target="1jjiBpRoDKVTdoKWtJoe-141">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-139" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-140" target="1jjiBpRoDKVTdoKWtJoe-143">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-140" value="&lt;font&gt;afterSingletonCreation(beanName)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="2620" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-141" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;将当前创建的beanName从&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;singletonsCurrentlyInCreation 集合中移除，因为bean实例已经创建完毕了&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=12 12;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1530" y="2625" width="632" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-142" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-143" target="1jjiBpRoDKVTdoKWtJoe-144">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-143" value="&lt;font&gt;addSingleton(beanName, singletonObject)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="2740" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-144" value="&lt;font style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;添加到单例池中：&lt;/font&gt;&lt;span style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none;&quot;&gt;singletonObjects(也就是通常所说的一级缓存)&lt;/font&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;labelBackgroundColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1518" y="2740" width="400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-145" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-146" target="1jjiBpRoDKVTdoKWtJoe-126">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1025" y="2860"/>
                            <mxPoint x="1025" y="2180"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-146" value="&lt;font&gt;retrun&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;&quot;&gt;singletonObject&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="2840" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-147" value="&lt;font&gt;return&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=12 12;strokeColor=#FF3333;" vertex="1" parent="1">
                    <mxGeometry x="970" y="2200" width="50" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-148" value="&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;fillWeight=4;hachureGap=8;hachureAngle=45;fillStyle=hachure;opacity=70;strokeColor=#00CC00;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;sketch=1;curveFitting=1;jiggle=2;glass=0;shadow=0;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1050" y="2920" width="1100" height="2120" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-149" value="AbstractAutowireCapableBeanFactory.createBean()" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1490" y="2890" width="420" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-150" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-152" target="1jjiBpRoDKVTdoKWtJoe-153">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-152" target="1jjiBpRoDKVTdoKWtJoe-157">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-152" value="&lt;font&gt;mbdToUse.prepareMethodOverrides()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="2960" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-153" value="&lt;font&gt;处理@Lookup相关的注解，这个注解几乎没怎么看见过，暂时不关心&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1518" y="2965" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-154" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-157" target="1jjiBpRoDKVTdoKWtJoe-158">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-155" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-157" target="1jjiBpRoDKVTdoKWtJoe-161">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-156" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-157">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="620" y="3070" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-157" value="&lt;font&gt;Object bean = resolveBeforeInstantiation(beanName, mbdToUse)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="3050" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-158" value="&lt;div&gt;&lt;font&gt;专门针对特殊的AOP,如果在这里就返回了代理bean对象，那么会直接返回&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; - 跳过正常的Bean创建流程（不会调用构造函数、不会进行属性填充等）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; - 直接调用 postProcessAfterInitialization()，给其他后置处理器一个处理代理对象的机会&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp; - 立即返回这个对象作为Bean实例&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;在spring5.3.x,在没有开启AOP的情况下,这里默认没有任何的扩展&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1518" y="3021.25" width="602" height="97.5" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-161" target="1jjiBpRoDKVTdoKWtJoe-162">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-160" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-161" target="1jjiBpRoDKVTdoKWtJoe-165">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-161" value="&lt;font&gt;Object beanInstance = doCreateBean(beanName, mbdToUse, args);&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="3150" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-162" value="&lt;font&gt;真正的创建逻辑&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1518" y="3155" width="102" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-163" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-165" target="1jjiBpRoDKVTdoKWtJoe-166">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-164" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-165" target="1jjiBpRoDKVTdoKWtJoe-170">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-165" value="&lt;font&gt;instanceWrapper = createBeanInstance(beanName, mbd, args)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="3230" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-166" value="&lt;font&gt;创建实例bean，这个方法的目的很简单，就是创建对象，但是内部的实现却很复杂，对于细节暂时可以不用关注(因为即使看了源码也记不住)，但是对于这个方法内创建bean的方式可以简单了解一下：&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. Supplier方法：优先级最高(这个可以简单了解一下)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2.&amp;nbsp; @Bean注解标注的方法&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3. 缓存的构造器/工厂方法(性能优化)：这个主要是用于原型bean，多次创建时可以复用已经解析过的构造方法，暂时不关心&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4. BPP推断的构造器,也即构造器注入(@Autowired标注的构造器，只有一个带参构造器，这里关于构造器的推断算法，暂时不关心)，但是需要注意的一点是，这里可是会造成循环依赖的(并且是不可解决的)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;5. 首选构造器&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;6. 无参构造器&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="3195" width="1190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-167" value="这里的核心就是创建对象，本质上就是通过反射来创建，但是需要注意的是，在这里只是创建了对象而已，bean的生命周期才刚刚开始，顺便提一下，这里构造器产生的循环依赖是不可解决的，spring会抛出异常的" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="3320" width="490" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-168" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-170" target="1jjiBpRoDKVTdoKWtJoe-171">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-169" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-170" target="1jjiBpRoDKVTdoKWtJoe-175">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-170" value="&lt;font&gt;applyMergedBeanDefinitionPostProcessors(mbd, beanType, beanName)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="3510" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-171" value="&lt;div&gt;在spring初始化时,默认会有三个MergedBeanDefinitionPostProcessor类型的BPP，分别为:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;- CommonAnnotationBeanPostProcessor&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&#x9;&lt;/span&gt;- 处理@Resource / @PostConstruct / @PreDestroy 等JSR-250注解 (暂时可以不用关系)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;- AutowiredAnnotationBeanPostProcessor forcus&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&#x9;&lt;/span&gt;- 处理自动装配注解, @Autowired / @Value / @Inject 等注解&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&#x9;&lt;/span&gt;- 核心作用: 扫描并缓存所有需要自动装配的字段和方法信息&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;- ApplicationListenerDetector forcus&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&#x9;&lt;/span&gt;- 检查Bean类型是否实现了ApplicationListener接口，记录相关信息，会在后续Bean初始化完成后的postProcessAfterInitialization方法中使用，&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&#x9;&lt;/span&gt;- 决定是否将监听器注册到ApplicationContext中&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="3455" width="900" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-172" value="注意,在这里针对 AutowiredAnnotationBeanPostProcessor 要额外说明一下，&lt;div&gt;在这里的处理只是收集信息，并没有真正的进行属性注入&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="3620" width="490" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-175" target="1jjiBpRoDKVTdoKWtJoe-176">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-175" target="1jjiBpRoDKVTdoKWtJoe-180">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-175" value="boolean earlySingletonExposure (绝大多数场景下都为true)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="3750" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-176" value="&lt;div&gt;boolean earlySingletonExposure = (mbd.isSingleton() &amp;amp;&amp;amp; this.allowCircularReferences &amp;amp;&amp;amp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;isSingletonCurrentlyInCreation(beanName));&lt;/span&gt;&lt;/div&gt;&lt;div&gt;3个条件缺一不可：必须是单例(原型bean的循环依赖直接抛出异常) ， 允许循环依赖引用(默认为true) ，并且当前bean正在创建中(在上面已经加入到对应的集合中了)&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="3747.5" width="880" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-177" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.969;entryY=-0.001;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-135" target="1jjiBpRoDKVTdoKWtJoe-176">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="2723" y="2390"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-180" target="1jjiBpRoDKVTdoKWtJoe-182">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-179" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-180" target="1jjiBpRoDKVTdoKWtJoe-189">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-180" value="addSingletonFactory(beanName, () -&amp;gt; getEarlyBeanReference(beanName, mbd, bean))" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="3890" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-181" value="&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; text-align: left;&quot;&gt;singletonsCurrentlyInCreation&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;rounded=1;fillWeight=4;hachureGap=8;hachureAngle=45;fillStyle=solid;opacity=70;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;rotation=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="2205" y="2191.25" width="210" height="142.5" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-182" value="&lt;div&gt;将当前要创建的beanName + 对应的工厂方法(singletonFactory)添加到三级缓存中&amp;nbsp;singletonFactories&lt;/div&gt;&lt;div&gt;这里也是循环依赖相关的逻辑，正常情况这里beanName对应的工厂方法是不会被执行的，后续在单独讲解循环依赖的时候会再次提到&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="3887.5" width="880" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-183" value="&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; text-align: left;&quot;&gt;singletonFactories&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;rounded=1;fillWeight=4;hachureGap=8;hachureAngle=45;fillStyle=solid;opacity=70;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;rotation=0;shadow=0;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="2770" y="3820" width="210" height="142.5" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-184" value="beanName" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=solid;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#1ba1e2;" vertex="1" parent="1">
                    <mxGeometry x="2230" y="2240" width="140" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-185" value="&lt;font face=&quot;Comic Sans MS&quot;&gt;beanName --&amp;gt; singletonFactory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=solid;curveFitting=1;opacity=70;strokeColor=#82b366;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;" vertex="1" parent="1">
                    <mxGeometry x="2770" y="3860" width="200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-186" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-189" target="1jjiBpRoDKVTdoKWtJoe-190">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-187" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-189" target="1jjiBpRoDKVTdoKWtJoe-195">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-188" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-189" target="1jjiBpRoDKVTdoKWtJoe-210">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-189" value="populateBean(beanName, mbd, instanceWrapper)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="4020" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-190" value="属性填充,这里是第二个会形成循坏依赖的地方(第一个是在上面的构造器注入的时候,上面的是无法解决的,spring默认选择直接抛出异常)&lt;div&gt;这里的属性填充通常包含3种类型：1. 通过@Autowired标注的字段的注入 2. @Autowired标注的setter()方法 3. @Value标注的字段&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="4017.5" width="720" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-191" value="关于依赖注入的细节同样也不需要关注,因为本质上就是通过反射来进行注入的，但是在这里额外的讲解一下循环依赖的种类&lt;div&gt;spring默认不会解决所有循环依赖,通常有以下几种情况的循环依赖：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;spring能解决的：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. @Autowired标注的字段注入和setter()方法注入&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;spring不能解决的：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 构造器注入的循环依赖：因为实例对象都没有，无法提前暴露引用到三级缓存中&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;解决办法：使用@Lazy注解&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3. AOP代理导致的循环依赖(特殊场景)：当循环依赖中的Bean需要被AOP代理（如@Async、@Transactional），且早期引用与最终对象不一致时&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;这个后续会单独讲解&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;解决方法：使用@Lazy注解&lt;br&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4. @DependsOn形成的循环依赖&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="4080" width="910" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-192" value="在这里也是暂时不关注，因为依赖注入本质就是反射, 后续在讲解循环依赖的时候会再次回到这里，但是同样也是不会讲解细节" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="4280" width="720" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-193" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-195" target="1jjiBpRoDKVTdoKWtJoe-196">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-194" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-195" target="1jjiBpRoDKVTdoKWtJoe-199">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-195" value="exposedObject = initializeBean(beanName, exposedObject, mbd)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#b85450;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="1380" y="4370" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-196" value="在上面对bean执行的操作有：实例化，属性注入，下面就进入到bean的初始化阶段了" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1870" y="4368.75" width="460" height="42.5" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-197" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-199" target="1jjiBpRoDKVTdoKWtJoe-200">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-198" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-199" target="1jjiBpRoDKVTdoKWtJoe-204">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-199" value="invokeAwareMethods(beanName, bean)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1730" y="4500" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-200" value="&lt;div&gt;&amp;nbsp;3个Aware接口的回调&lt;/div&gt;&lt;div&gt;&amp;nbsp; - BeanNameAware.setBeanName(beanName) ：对象可以获得自己在容器中的名字&lt;/div&gt;&lt;div&gt;&amp;nbsp; - BeanClassLoaderAware.setBeanClassLoader(bcl) ：对象可以获得加载自己的类加载器&lt;/div&gt;&lt;div&gt;&amp;nbsp; - BeanFactoryAware.setBeanFactory(this) ： 对象可以获得工厂&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="2220" y="4485" width="525" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-201" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-204" target="1jjiBpRoDKVTdoKWtJoe-205">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-202" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-204" target="1jjiBpRoDKVTdoKWtJoe-208">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-203" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-204" target="1jjiBpRoDKVTdoKWtJoe-214">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-204" value="wrappedBean = applyBeanPostProcessorsBeforeInitialization(wrappedBean, beanName)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1730" y="4610" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-205" value="&lt;div&gt;初始化前的扩展&lt;/div&gt;在这里默认的这些BPP,并没有做什么扩展，在这里做的事情为：7个Aware接口的注入 &amp;amp; @PostConstruct方法的执行" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="2220" y="4611.25" width="630" height="37.5" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-206" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-208" target="1jjiBpRoDKVTdoKWtJoe-211">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-207" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-208" target="1jjiBpRoDKVTdoKWtJoe-212">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-208" value="invokeInitMethods(beanName, wrappedBean, mbd);" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1730" y="4720" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-209" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; face=&quot;Comic Sans MS&quot;&gt;bean实例化前的扩展：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; face=&quot;Comic Sans MS&quot;&gt;调用&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Comic Sans MS&amp;quot;;&quot;&gt;InstantiationAwareBeanPostProcessor.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;postProcessBeforeInstantiation()&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;作用：&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: center;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;在 Bean 实例化之前执行，可以返回一个代理对象来替代正常的实例化流程&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;rounded=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="170" y="3010" width="451.5" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-210" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;bean实例化之后，属性填充之前的扩展：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;InstantiationAwareBeanPostProcessor.postProcessAfterInstantiation()&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;特点为：bean实例已经创建，属性还未填充&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;返回值：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. true：继续正常的属性填充流程&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 返回false,跳过后续的属性填充，直接进入到初始化阶段&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;作用：自定义字段注入的理想时机&lt;/font&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;rounded=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="130" y="3985" width="451.5" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-211" value="该方法负责在Bean属性填充完成后，按照顺序调用两种初始化回调&lt;div&gt;1.&amp;nbsp;先调用 InitializingBean.afterPropertiesSet()（如果实现了该接口）--&amp;gt; 通常使用的是这种初始化回调方式,也推荐使用这种&lt;/div&gt;&lt;div&gt;2.再调用自定义的 init-method（如果配置了）&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="2220" y="4710.63" width="670" height="58.75" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-212" value="wrappedBean = applyBeanPostProcessorsAfterInitialization(wrappedBean, beanName)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1730" y="4820" width="430" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-213" value="初始化后的后置处理器扩展 (AOP代理通常在这里发生) 后续在讲解事务的时候这里会在提到，在未开启任何其他特性的时候(比如AOP,事务(当然事务本身也是通过AOP来实现的))&lt;div&gt;&lt;div&gt;&amp;nbsp; - ApplicationContextAwareProcessor: do nothing&lt;/div&gt;&lt;div&gt;&amp;nbsp; - ImportAwareBeanPostProcessor: do nothing&lt;/div&gt;&lt;div&gt;&amp;nbsp; - BeanPostProcessorChecker: do nothing&lt;/div&gt;&lt;div&gt;&amp;nbsp; - CommonAnnotationBeanPostProcessor: do nothing&lt;/div&gt;&lt;div&gt;&amp;nbsp; - AutowiredAnnotationBeanPostProcessor: do nothing&lt;/div&gt;&lt;div&gt;&amp;nbsp; - ApplicationListenerDetector: 注册事件监听器&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;在这里只有最后一个后置处理器在这里有对应的处理逻辑:那就是&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ApplicationListenerDetector&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;将实现了&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ApplicationListener 接口的单例bean注册到applicationContext中(更具体点是注册到默认的事件多播器中:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;SimpleApplicationEventMulticaster&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="2220" y="4810.62" width="990" height="159.38" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-214" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;初始化前的扩展方法，目前没看到做了什么重要的操作&lt;/font&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;rounded=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#d6b656;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="140" y="4575" width="451.5" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-215" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.655;entryY=0.945;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-212" target="1jjiBpRoDKVTdoKWtJoe-195">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1662" y="4840"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-216" value="return" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1670" y="4850" width="46" height="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
