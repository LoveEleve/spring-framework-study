                    <mxGeometry x="2830" y="1390" width="20" height="183.75" as="geometry"/>
                </mxCell>
                <mxCell id="MO5rZfF7vPib44zuhW4v-122" value="&lt;span style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;ConfigurationClassPostProcessor&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;labelBackgroundColor=default;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="2865" y="1390" width="250" height="30" as="geometry"/>
