                <mxCell id="pmoIR6_AIWQnp-MZ1eYm-22" value="ConfigurationClassPostProcessor # postProcessBeanDefinitionRegistry(BeanDefinitionRegistry registry)" style="text;whiteSpace=wrap;fontFamily=Menlo, Monaco, Courier New, monospace;labelBorderColor=none;strokeColor=#FF3333;dashed=1;dashPattern=12 12;" parent="1" vertex="1">
