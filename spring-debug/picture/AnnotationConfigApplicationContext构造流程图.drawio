                <mxCell id="1jjiBpRoDKVTdoKWtJoe-104" value="&lt;font&gt;String beanName = transformedBeanName(name)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1045" y="1662.5" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-105" value="&lt;font&gt;beanName规整化,注意这里是返回了一个新的beanName，而不是直接修改传入的name，&lt;/font&gt;&lt;div&gt;&lt;font&gt;在这里是：&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;name = &amp;amp;xxx&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;beanName = xxx&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="1518" y="1650" width="550" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-106" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.293;entryY=0.004;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-100" target="1jjiBpRoDKVTdoKWtJoe-101">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-107" value="&lt;div&gt;&lt;div&gt;&lt;font&gt;在这里需要注意的是：这里面会出现循环依赖相关的代码处理,为了避免图形太过庞大，这里展示不考虑循环依赖的相关代码逻辑，主要关注单例Bean实例化的生命周期&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
