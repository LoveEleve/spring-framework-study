                <mxCell id="pmoIR6_AIWQnp-MZ1eYm-146" value="&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;获取在parse()阶段处理过的配置类&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;" parent="1" vertex="1">
