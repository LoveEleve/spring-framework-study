                <mxCell id="1jjiBpRoDKVTdoKWtJoe-91" value="&lt;font&gt;如果工厂bean的类型是 SmartFactoryBean 类型的(这个类型是FactoryBean的子类，用于控制产品bean的实例化时机)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
