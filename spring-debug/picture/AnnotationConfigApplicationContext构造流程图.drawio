                <mxCell id="1jjiBpRoDKVTdoKWtJoe-126" value="&lt;font&gt;sharedInstance = getSingleton(beanName,factoryMethod)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=#56517e;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=none;" vertex="1" parent="1">
