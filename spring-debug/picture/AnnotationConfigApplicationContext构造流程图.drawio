                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="1jjiBpRoDKVTdoKWtJoe-111" target="1jjiBpRoDKVTdoKWtJoe-116">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-111" value="&lt;font&gt;Object sharedInstance = getSingleton(beanName)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1045" y="1780" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-112" value="&lt;div&gt;&lt;div&gt;&lt;font&gt;需要注意的是,这里的返回值可能有3种情况：&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. null：重来没有创建过,这也是当前关系的情况&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2. 从二级缓存中获取到的循环依赖的早期引用(这个单独使用一个图来讲解)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; &lt;/span&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3. 完整对象: 这种情况通常是spring“稳定后”，没什么好说的&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=12 12;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1520" y="1767.5" width="550" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="1jjiBpRoDKVTdoKWtJoe-113" value="&lt;div&gt;&lt;div&gt;&lt;font&gt;在这里目前只关注第一种情况(也就是为null的情况)，对于循环依赖的情况，则单独讲解&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;dashed=1;dashPattern=12 12;strokeColor=default;" vertex="1" parent="1">
